MONGO_URI="mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/drstethos"
JWT_SECRET="your_jwt_secret"
PORT=5000
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Portal Admin"
EMAIL_REPLY_TO=support@example.com
FRONTEND_URL=http://localhost:5173
FIREBASE_PROJECT_ID=drstethos-app
# Set one credential source for the standalone backend:
# GOOGLE_APPLICATION_CREDENTIALS=D:\path\to\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"drstethos-app",...}
